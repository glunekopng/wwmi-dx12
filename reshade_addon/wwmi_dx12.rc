#include <winver.h>
#include "build_stamp.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION WWMI_VERSION_NUM
PRODUCTVERSION WWMI_VERSION_NUM
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "WWMI-DX12, a ReShade add-on"
            VALUE "FileVersion", WWMI_VERSION
            VALUE "ProductName", "WWMI-DX12"
            VALUE "ProductVersion", WWMI_VERSION
            VALUE "Comments", WWMI_BUILD_SHA
            VALUE "OriginalFilename", "wwmi_dx12.addon64"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
